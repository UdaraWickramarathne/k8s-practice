# Example environment variables for voting-service (do NOT commit secrets)
# Copy to .env or set as environment variables in your hosting environment

# Redis connection used by the API (format: host:port or redis://...)
REDIS_CONNECTION=localhost:6379

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Optional: URLs to bind (if not using appsettings or launchSettings)
# DOTNET_URLS=http://localhost:5000;https://localhost:5001
